# Heretic, installed at a pinned tag, in a box that cannot reach the network when it runs.
#
# THE BUILD/RUN SPLIT, AND WHY IT IS NOT A HOLE
#
# Dependencies have to arrive somehow, and `pip install` needs a network, so the build has one.
# The RUN does not (`run-isolated.sh` passes `--network none`), and that is where the distinction
# earns its keep: at build time the box contains nothing of ours, no weights, no corpus, no
# credentials, nothing to take. By the time it holds our data it has no way to send it anywhere.
#
# The build is also where the supply chain is pinned. Heretic is cloned at a tag, that tag's
# commit is recorded in the image, and the run records the image digest, so a published row can
# be traced to the exact code that produced it. Someone disputing a number can check what we ran.
#
# WHY HERETIC IS NOT INSTALLED INTO THE SHARED BASE
#
# Each tool gets its own layer on the shared base, because their dependency trees conflict:
# Heretic wants transformers ~=5.6 and other tools pin differently. One image per tool keeps each
# comparison honest about the environment it ran in, instead of resolving a compromise none of the
# authors chose.
#
# Build:
#   docker build -f head-to-head/Dockerfile.heretic --build-arg HERETIC_REF=v1.4.0 -t senbon-bench:heretic .
FROM senbon-bench:tool

# Pinned by tag, and the tag's commit is recorded below. v1.4.0 is the current release as of
# 2026-08-05. Never `master`: a benchmark whose subject moves between arms is not a benchmark.
#
# WHAT THIS TAG IS, AS A METHOD. v1.4.0 applies Magnitude-Preserving Orthogonal Ablation (MPOA),
# merged as Heretic's pull request 52 and released in v1.2.0, and it offers no way to select a
# different one. That is why the arm needs no method flag today.
#
# BEFORE BUMPING THIS, CHECK WHETHER THE METHOD BECAME SELECTABLE. Heretic merged a modifier plugin
# API together with Arbitrary-Rank Ablation on 2026-10-01, after this tag. From the first release
# carrying it, a tag no longer identifies a method, and an arm that inherits whatever the release
# defaults to is an arm that cannot say what it ran. `run_heretic.py` writes the configuration it
# gives Heretic and leaves it beside the result for exactly this case: name the method there.
# head-to-head/CONTRACT.md carries the reader-facing version of this.
ARG HERETIC_REF=v1.4.0

USER root
WORKDIR /opt

RUN git clone --quiet --branch "$HERETIC_REF" --depth 1 \
      https://github.com/p-e-w/heretic.git /opt/heretic \
 && git -C /opt/heretic rev-parse HEAD > /opt/heretic-commit.txt \
 && cat /opt/heretic-commit.txt

# THE ASSERTION WAS THE GUARD, NOT A FLAG, AND IT WAS TOO NARROW. Both halves recorded, because
# this comment was wrong in one way and incomplete in another.
#
# It used to open "--no-deps on torch specifically", and the install below has never carried
# `--no-deps`. There was nothing to find: a reader checking that claim against the command would
# have looked for a flag that is not there, the same defect shape as a comment citing a file path
# that does not exist. What actually held the torch pin was the `assert` beside it.
#
# And the assert was about torch, which was never the package that moved. **Heretic v1.4.0 declares
# `numpy~=2.2`**, the base pinned `numpy==2.1.3`, and `2.1.3` does not satisfy `>=2.2, ==2.*`, so
# this install upgraded numpy on every build ever made while the senbonzakura image left it alone.
# The two arms differed in their numeric stack by construction and no guard here could see it,
# because a one-package assertion cannot see a second package move.
#
# So numpy is now pinned HERE, explicitly, at the version the base pins, rather than inherited
# from whatever pip resolves for Heretic's own range. An arm that cannot state its own numeric
# stack is not stating its environment, and `--no-deps` is still not the answer: Heretic's own
# dependency tree is wanted, and only this one package is held.
#
# `--verify-pins` replaces the hand-written literal. It reads this image's declared pins from
# `BENCH_DECLARED_PINS` and holds every one of them, plus the packages named in
# `BENCH_REQUIRED_PRESENT`, so the check and the record are one string and adding a fourth package
# is editing the ARG below. See `head-to-head/benchenv.py` for why that matters more than it looks.
# ONE VERSION, ONE PLACE. `NUMPY_PIN` feeds both the install below and the declared string the
# check reads, so the pin and the thing enforcing it cannot drift. Writing `2.5.3` twice in one
# file is the shape of defect this whole change is about.
ARG TORCH_PIN=2.5.1
ARG NUMPY_PIN=2.4.6
ARG BENCH_PINS="torch==$TORCH_PIN numpy==$NUMPY_PIN"
# tokenizers arrives with Heretic's `transformers[kernels]~=5.6` and its version is NOT pinned
# here, pending a decision on pinning transitive closures. It changes what the model is shown, so
# it is required present and recorded rather than left unmentioned.
ARG BENCH_REQUIRED="transformers tokenizers accelerate peft optuna"
ENV BENCH_DECLARED_PINS=$BENCH_PINS \
    BENCH_REQUIRED_PRESENT=$BENCH_REQUIRED

RUN pip install --no-cache-dir /opt/heretic "numpy==$NUMPY_PIN" \
 && python /opt/benchenv.py --verify-pins \
 && python -c "import heretic; print('heretic imports')"

# RE-BAKED, because the freeze inherited from the base describes the base. This layer installed a
# whole dependency tree, and a reader handed the base's freeze would be reading the wrong set under
# the right filename.
RUN pip freeze > /opt/bench-env.txt \
 && echo "bench-env.txt: $(wc -l < /opt/bench-env.txt) distributions"

LABEL org.senbonzakura.bench.declared-pins=$BENCH_PINS \
      org.senbonzakura.bench.required-present=$BENCH_REQUIRED \
      org.senbonzakura.bench.tool-ref=$HERETIC_REF \
      org.senbonzakura.bench.freeze="/opt/bench-env.txt"

USER bench
WORKDIR /work

# Recorded so a result can name its subject without the operator having to remember.
ENV BENCH_TOOL=heretic \
    BENCH_TOOL_REF=$HERETIC_REF

CMD ["python", "-c", "import heretic, torch; print('heretic ready, torch', torch.__version__, 'cuda', torch.cuda.is_available())"]
