# No loaded guns: never commit weights, models, or harmful/harmless prompt sets.
*.safetensors
*.bin
*.gguf
*.pt
*.pth
models/
abliterated/
out/
checkpoints/
results/
plots/
# datasets (the harmful/harmless contrast + eval sets stay private)
ds/
*_ds/
data/
*.arrow
# Retained generations and per-prompt margins. These hold harmful prompts and the
# replies a model gave to them, so the default is out.
*.jsonl
# evidence/ is the one committed home, and it needs an explicit negation: the rule
# above would otherwise force `git add -f`, which defeats the ignore it bypasses.
# Files landing here must already have their prompt and generation fields stripped,
# which tools/check_prompt_artefacts.py enforces rather than trusts.
!evidence/
!evidence/**/*.jsonl
# python
__pycache__/
*.pyc
build/
dist/
.venv/
venv/
*.egg-info/
.coverage
.coverage.*
htmlcov/
.optuna*/
optuna*.db

# The committed toy track. Every dataset rule above catches a save_to_disk layout, so
# the one example a stranger can run has to re-include the DIRECTORY before its
# contents: git does not descend into an excluded directory, so negating only the files
# would do nothing. Its prompts are synthetic placeholders, never real harmful text.
!examples/toy-track/
!examples/toy-track/**/
!examples/toy-track/**

# Generated by tools/make_dryrun_spec.py from the committed spec. Derived, not authored: keeping
# them tracked would invite editing the copy instead of the original, which is the drift the
# generator exists to prevent.
holst/*-dryrun.toml
holst/*-oncard.toml

# Terminal captures used only to verify a recording caught what it claims.
# Not published, and the banner it captures is randomised, so it is not a golden file.
docs/tapes/captured/
