# Comment: Christ is King  # noqa: ERA001
#
# Coverage for the checker distribution alone, measured with its own tests:
#
#   coverage run --rcfile=checker/.coveragerc --data-file=<scratch>/.coverage \
#       -m pytest -o addopts="" tests/<the files that import senbonzakura_check>
#   coverage report --rcfile=checker/.coveragerc --data-file=<scratch>/.coverage
#
# WHY THIS EXISTS. The root pyproject.toml measures `source = ["senbonzakura"]`, so the checker
# package was outside every coverage figure the project has ever printed. A checker that installs
# with nothing and is read by people who did not write it had no branch coverage number at all.
# The root total is deliberately not changed here: adding the checker to it would move the 95 per
# cent floor on a figure nobody has measured with the full suite, and that is a decision for the
# operator, not a side effect of wiring a second package in.

[run]
source = senbonzakura_check
branch = True

[report]
precision = 2
show_missing = True
skip_empty = True
